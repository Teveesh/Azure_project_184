# Copy this file to `.env` and fill in your own values, OR set these as
# real environment variables in your shell/session before running the app.
#
# `.env` itself is already listed in .gitignore -- never commit real
# credentials. This file only shows the variable NAMES with placeholder
# values, no real keys.
#
# All four variables are OPTIONAL. The rest of the dashboard (local
# partition-key analysis) works fully without them.

COSMOS_ENDPOINT=https://<your-account-name>.documents.azure.com:443/
COSMOS_KEY=<your-primary-or-secondary-key>
COSMOS_DATABASE=OrdersDB
COSMOS_CONTAINER=Orders
